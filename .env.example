# =====================================================================
# CONFIGURAÇÕES DA PIPELINE CANAL DARK (FASE 1)
# =====================================================================

# Google Gemini API (Geração do Roteiro)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API (Síntese de Voz / Narração)
# Obtenha em: https://elevenlabs.io/
ELEVENLABS_API_KEY=sua_chave_elevenlabs_aqui
# ID da voz desejada (exemplo: Adam = pNInz6obpgDQGcFmaJgB, Rachel = 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Configurações do Whisper (Transcrição e Sincronização Local)
# Opções de modelo: tiny, base, small, medium (base é recomendado para bom balanço velocidade/precisão)
WHISPER_MODEL=base

# Configurações de Vídeo (MoviePy)
# Formatos: 16:9 (1920x1080 - Horizontal) ou 9:16 (1080x1920 - Shorts/Reels/TikTok)
VIDEO_ASPECT_RATIO=16:9
VIDEO_FPS=24
